# App
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Ports (docker-compose)
# Host port for the Next.js app (dev + prod containers)
APP_PORT=3000
# Host port for PostgreSQL, bound to 127.0.0.1 only
POSTGRES_PORT=5432

# Database
DATABASE_URL=postgres://link:link@localhost:5432/link

# Used only inside the docker-compose network.
# DATABASE_URL for containers is composed from these three values.
POSTGRES_USER=link
POSTGRES_PASSWORD=link
POSTGRES_DB=link
