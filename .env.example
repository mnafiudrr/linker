# App
NODE_ENV=development
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Database (host-side port mapping is 5432 by docker-compose)
DATABASE_URL=postgres://link:link@localhost:5432/link

# Used only inside docker-compose network
POSTGRES_USER=link
POSTGRES_PASSWORD=link
POSTGRES_DB=link
